{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-ops-web",
  // vinext's Cloudflare Vite integration resolves this virtual entry.
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "not_found_handling": "none" },
  // Add DB only after `wrangler d1 create hotel-ops` returns its real database_id.
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "hotel-ops-attachments" }],
  "vars": { "MAX_UPLOAD_BYTES": "10485760" }
}
